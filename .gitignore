# =============================================================================
# PYTHON / DJANGO
# =============================================================================

# Byte-compiled / optimized / DLL files
**/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
**/env/
**/venv/
**/ENV/
*.egg-info/
**/dist/
**/build/
*.egg

# Django specific
**/*.log
*.pot
*.pyc
db.sqlite3
**/media/
**/mediafiles/
**/staticfiles/
**/static/
**/settings_local.py

# Firebase credentials
**/*firebase-adminsdk.json

# Django migrations (uncomment if you want to exclude them)
# **/migrations/
# !**/migrations/__init__.py
# !**/migrations/0001_initial.py

# =============================================================================
# NODE.JS / NEXT.JS
# =============================================================================

# Dependencies
**/node_modules
**/.pnp
**/.pnp.*

# Yarn
**/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
**/coverage

# Next.js
**/.next/
**/out/

# Production builds
**/build

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
**/next-env.d.ts

# Vercel
**/.vercel

# =============================================================================
# ENVIRONMENT & SECRETS
# =============================================================================

# Environment files
.env
.env.*
!frontend/.env.*

# Secrets
**/.secrets/**/*

# Firebase
**/.firebase/*

# SSL Certificates
**.csr
**.key
*.pem

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# IDEs
.vscode/
.idea/

# System Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# =============================================================================
# DOCKER & DEPLOYMENT
# =============================================================================

# Docker volumes (if any local data)
# docker-volumes/

# =============================================================================
# MISC
# =============================================================================

# Temporary files
*.tmp
*.temp